# Copy this to .env and fill in values
# NEVER commit .env to git

# Port to listen on
PORT=3010

# Set to 'production' on live server
NODE_ENV=development

CSRF_SECRET=replace-with-64-byte-random-hex-string

# Account Manager public URL: the /authorize redirect, logout, the settings-page link
ACCOUNT_MANAGER_URL=http://localhost:3011

# Optional. Base for server-to-server calls (JWKS key fetch, /token, discovery, /api/mcp-client).
# Server-side calls go over the Docker network; the public URL is refused from inside Docker on the Pi.
# In Docker set it to http://account-manager:3001 (no /accounts suffix: nginx maps /accounts/* to its root).
# Unset: these calls use ACCOUNT_MANAGER_URL.
# ACCOUNT_MANAGER_INTERNAL_URL=http://account-manager:3001

# OAuth client for the game backlog web PKCE flow (browser login)
# Copy these from account-manager startup logs or account-manager/.env
OAUTH_CLIENT_ID=gamebacklog-web
OAUTH_CLIENT_SECRET=replace-with-secret-from-account-manager
OAUTH_REDIRECT_URI=http://localhost:3010/auth/callback
