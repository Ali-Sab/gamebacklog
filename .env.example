# Copy this to .env and fill in values
# NEVER commit .env to git

# Port to listen on
PORT=3010

# Set to 'production' on live server
NODE_ENV=development

CSRF_SECRET=replace-with-64-byte-random-hex-string

# Account Manager — used by the auth callback, PKCE flow, and JWKS key fetch
ACCOUNT_MANAGER_URL=http://localhost:3011

# OAuth client for the game backlog web PKCE flow (browser login)
# Copy these from account-manager startup logs or account-manager/.env
OAUTH_CLIENT_ID=gamebacklog-web
OAUTH_CLIENT_SECRET=replace-with-secret-from-account-manager
OAUTH_REDIRECT_URI=http://localhost:3010/auth/callback
