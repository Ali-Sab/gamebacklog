# Copy this to .env and fill in values
# NEVER commit .env to git

# Port to listen on
PORT=3000

# Set to 'production' on live server
NODE_ENV=development

CSRF_SECRET=replace-with-64-byte-random-hex-string

# Account Manager — used by the auth callback and PKCE flow
ACCOUNT_MANAGER_URL=http://localhost:3001
ACCOUNT_MANAGER_ISSUER=http://localhost:3001

# Path to the account-manager's RSA public key (RS256 token verification)
# If left empty, defaults to ../account-manager/data/keys/public.pem
PUBLIC_KEY_PATH=

# OAuth client registered in account-manager for the game backlog web PKCE flow
# Must match GAMEBACKLOG_CLIENT_ID / GAMEBACKLOG_CLIENT_SECRET in account-manager
GAMEBACKLOG_CLIENT_ID=replace-with-uuid
GAMEBACKLOG_CLIENT_SECRET=replace-with-32-byte-random-hex-string
GAMEBACKLOG_REDIRECT_URI=http://localhost:3000/auth/callback

# Link shown in the Settings tab → "Open Account Manager"
VITE_ACCOUNT_MANAGER_URL=http://localhost:3001
